{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allneeds.app/schemas/observation-inference-source-v1.json",
  "title": "Observation Inference Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modelVersion",
    "provenance",
    "slots",
    "expressions",
    "lexicalBridges",
    "surfaceTerms",
    "guidanceRules",
    "explorationPools"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "modelVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commit", "importedAt", "cueRows"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "importedAt": { "type": "string", "format": "date" },
        "cueRows": { "type": "integer", "minimum": 1 }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/slot" }
    },
    "expressions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/expression" }
    },
    "lexicalBridges": {
      "type": "array",
      "items": { "$ref": "#/$defs/lexicalBridge" }
    },
    "surfaceTerms": {
      "type": "array",
      "items": { "$ref": "#/$defs/surfaceTerm" }
    },
    "guidanceRules": {
      "type": "array",
      "items": { "$ref": "#/$defs/guidanceRule" }
    },
    "explorationPools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unmetFeelings", "metFeelings", "needs"],
      "properties": {
        "unmetFeelings": { "$ref": "#/$defs/slugPool" },
        "metFeelings": { "$ref": "#/$defs/slugPool" },
        "needs": { "$ref": "#/$defs/slugPool" }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "slugPool": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pattern", "flags"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "pattern": { "type": "string", "minLength": 1 },
        "flags": { "type": "string", "pattern": "^[imsu]*$" }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "noun", "question", "summary", "examples", "detectors"],
      "properties": {
        "id": { "enum": ["time", "context", "sensory", "measure"] },
        "label": { "type": "string", "minLength": 1 },
        "noun": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "examples": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "detectors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/detector" } }
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tier", "pattern", "flags", "feelingSlugs", "needSlugs", "cueIds", "examples", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "tier": { "enum": ["direct", "related", "broad"] },
        "pattern": { "type": "string", "minLength": 1 },
        "flags": { "type": "string", "pattern": "^[imsu]*$" },
        "feelingSlugs": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
        "needSlugs": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
        "cueIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "examples": { "type": "array", "items": { "type": "string" } },
        "provenance": { "type": "string", "minLength": 1 }
      }
    },
    "lexicalBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entityType", "slug", "terms", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "entityType": { "enum": ["feeling", "need", "fauxFeeling"] },
        "slug": { "$ref": "#/$defs/slug" },
        "terms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "provenance": { "type": "string", "minLength": 1 }
      }
    },
    "surfaceTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "terms"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "label": { "type": "string", "minLength": 1 },
        "terms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "guidanceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "explanation", "terms", "patterns", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "label": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 },
        "terms": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "patterns": { "type": "array", "items": { "$ref": "#/$defs/detector" } },
        "provenance": { "type": "string", "minLength": 1 }
      }
    }
  }
}
