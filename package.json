{
  "name": "allneeds-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "compile:alexithymia": "node scripts/compile-alexithymia-support.mjs",
    "generate:observation-inference": "node scripts/compile-observation-inference.mjs --write",
    "check:observation-inference": "node scripts/compile-observation-inference.mjs --check",
    "dev": "pnpm compile:alexithymia && pnpm check:observation-inference && vite",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm test:e2e:playwright && pnpm test:e2e:outage",
    "test:e2e:playwright": "playwright test",
    "test:e2e:observation-matrix": "playwright test --config=playwright.observation.config.ts",
    "test:e2e:outage": "node scripts/verify-offline-reconnect.mjs",
    "test:e2e:headed": "playwright test --headed",
    "build": "node scripts/compile-alexithymia-support.mjs --check && node scripts/compile-observation-inference.mjs --check && tsc -b && vite build && node scripts/copy-spa-fallback.mjs && node scripts/generate-service-worker.mjs && node scripts/verify-production-build.mjs",
    "preview": "vite preview",
    "check": "pnpm compile:alexithymia && pnpm typecheck && pnpm test && pnpm build",
    "check:browser": "pnpm build && pnpm test:e2e",
    "check:all": "pnpm check && pnpm test:e2e"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.1.1",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vitest": "4.0.17"
  }
}
